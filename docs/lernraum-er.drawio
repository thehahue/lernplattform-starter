        <mxCell id="many-note" value="&lt;b&gt;n:m: Aufgabe ↔ Schlagwort&lt;/b&gt;&lt;br&gt;Eine Aufgabe hat 0..n Schlagwörter.&lt;br&gt;Ein Schlagwort gehört zu 0..n Aufgaben.&lt;br&gt;Die Tabelle task_tag speichert jede Zuordnung einmal." style="text;html=1;align=left;fontSize=15;fontColor=#655481;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="850" y="915" width="640" height="105" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;PK&lt;/b&gt; = Primärschlüssel · &lt;b&gt;FK&lt;/b&gt; = Fremdschlüssel · &lt;b&gt;UQ&lt;/b&gt; = UNIQUE · &lt;b&gt;[NULL]&lt;/b&gt; = optional&lt;br&gt;Alle anderen Attribute sind NOT NULL. Ein Fremdschlüssel zeigt auf die ID einer anderen Tabellenzeile.&lt;br&gt;&lt;br&gt;&lt;b&gt;1:1 fachlich:&lt;/b&gt; Benutzer und Profil werden in derselben Transaktion erstellt. FK + UNIQUE allein erlaubt 0 oder 1 Profil.&lt;br&gt;&lt;b&gt;Service-Regeln:&lt;/b&gt; Eltern-Thema im selben Fach, keine Zyklen, nur eigene Daten/Schlagwörter.&lt;br&gt;&lt;b&gt;Löschen:&lt;/b&gt; Fächer/Themen erst leer löschen; Aufgaben/Tags löschen nur ihre task_tag-Zeilen mit." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f4fa;strokeColor=#e4e0ed;fontSize=15;fontColor=#605973;align=left;verticalAlign=top;spacing=18;" parent="1" vertex="1">
